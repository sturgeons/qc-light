<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.Qc_1" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowBackground">@color/ink</item>
        <item name="android:statusBarColor">@color/ink</item>
        <item name="android:navigationBarColor">@color/ink</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="colorPrimary">@color/gold</item>
        <item name="colorOnPrimary">#1A1408</item>
        <item name="colorSecondary">@color/cyan</item>
        <item name="android:textColorPrimary">@color/text_bright</item>
    </style>

    <style name="Theme.Qc_1" parent="Base.Theme.Qc_1" />

    <style name="CmdButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:padding">12dp</item>
    </style>

    <style name="CmdButtonFull">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:padding">12dp</item>
    </style>
</resources>
