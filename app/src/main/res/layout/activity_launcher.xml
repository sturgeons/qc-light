<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/tech_bg_gradient"
    android:padding="24dp"
    android:gravity="center">

    <!-- Logo/标题区域 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🚗"
        android:textSize="80sp"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="车灯控制系统"
        android:textSize="32sp"
        android:textStyle="bold"
        android:textColor="@color/text_accent"
        android:shadowColor="#00D4FF"
        android:shadowRadius="8"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Vehicle Light Control System"
        android:textSize="14sp"
        android:textColor="@color/text_dim"
        android:layout_marginBottom="60dp"/>

    <!-- 控制页面按钮区域 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center">

        <!-- CX483控制页面按钮 -->
        <LinearLayout
            android:id="@+id/btnOpenCX483"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:orientation="vertical"
            android:background="@drawable/tech_button_left_off"
            android:gravity="center"
            android:padding="16dp"
            android:layout_marginBottom="20dp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💡"
                android:textSize="40sp"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CX483 车后灯控制"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/text_bright"
                android:shadowColor="#00D4FF"
                android:shadowRadius="4"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rear Light Control"
                android:textSize="12sp"
                android:textColor="@color/text_dim"
                android:layout_marginTop="4dp"/>
        </LinearLayout>

        <!-- U625控制页面按钮 -->
        <LinearLayout
            android:id="@+id/btnOpenU625"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:orientation="vertical"
            android:background="@drawable/tech_button_right_off"
            android:gravity="center"
            android:padding="16dp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✨"
                android:textSize="40sp"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="U625 格栅灯控制"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/text_bright"
                android:shadowColor="#FF6B35"
                android:shadowRadius="4"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Grille Light Control"
                android:textSize="12sp"
                android:textColor="@color/text_dim"
                android:layout_marginTop="4dp"/>
        </LinearLayout>
    </LinearLayout>

    <!-- 版本信息 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Version 1.0"
        android:textSize="11sp"
        android:textColor="@color/text_dim"
        android:layout_marginTop="60dp"/>
</LinearLayout>

